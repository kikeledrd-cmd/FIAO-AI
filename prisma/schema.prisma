generator client {
  provider = "prisma-client"
  output   = "../packages/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  CASHIER
}

enum AuditSource {
  UI
  API
  OFFLINE_SYNC
}

enum OperationStatus {
  ACCEPTED
  ACCEPTED_WITH_CONFLICT
  REJECTED
}

enum SyncConflictStatus {
  OPEN
  RESOLVED
}

model OwnerAccount {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  branches            Branch[]
  users               User[]
  devices             Device[]
  sessions            Session[]
  ownerAuthorizations OwnerAuthorization[]
  auditEvents         AuditEvent[]
  clientOperations    ClientOperation[]
  syncChanges         SyncChange[]
  syncConflicts       SyncConflict[]
  products            Product[]
  productStocks       ProductStock[]
  stockMovements      StockMovement[]
  sales               Sale[]
  customers           Customer[]
  creditMovements     CreditMovement[]
  suppliers           Supplier[]
  purchases           Purchase[]
  purchaseLines       PurchaseLine[]
  cashSessions        CashSession[]
  cashMovements       CashMovement[]
  apartados           Apartado[]
  apartadoLines       ApartadoLine[]
  loyaltyConfig       LoyaltyConfig?
  loyaltyMovements    LoyaltyMovement[]
  loyaltyRewards      LoyaltyReward[]
  promotions          Promotion[]
}

model Branch {
  id                  String               @id @default(uuid()) @db.Uuid
  ownerId             String               @db.Uuid
  name                String
  address             String?
  timezone            String               @default("America/Santo_Domingo")
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  owner               OwnerAccount         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  userAssignments     UserBranch[]
  ownerAuthorizations OwnerAuthorization[]
  auditEvents         AuditEvent[]
  clientOperations    ClientOperation[]
  syncChanges         SyncChange[]
  syncConflicts       SyncConflict[]
  products            Product[]
  productStocks       ProductStock[]
  stockMovements      StockMovement[]
  sales               Sale[]
  customers           Customer[]
  creditMovements     CreditMovement[]
  suppliers           Supplier[]
  purchases           Purchase[]
  purchaseLines       PurchaseLine[]
  cashSessions        CashSession[]
  cashMovements       CashMovement[]
  apartados           Apartado[]
  apartadoLines       ApartadoLine[]
  loyaltyMovements    LoyaltyMovement[]

  @@index([ownerId, active])
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  ownerId              String               @db.Uuid
  name                 String
  phoneE164            String               @unique @db.VarChar(16)
  pinHash              String               @db.VarChar(255)
  role                 Role
  active               Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  owner                OwnerAccount         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branchAssignments    UserBranch[]
  devices              Device[]
  apartados            Apartado[]           @relation("ApartadoActor")
  sessions             Session[]
  authorizationsIssued OwnerAuthorization[] @relation("OwnerAuthorizationAuthorizer")
  auditEvents          AuditEvent[]         @relation("AuditActor")
  clientOperations     ClientOperation[]    @relation("OperationActor")
  sales                Sale[]               @relation("SaleActor")
  cashSessionsOpened   CashSession[]        @relation("CashSessionOpenedBy")
  cashSessionsClosed   CashSession[]        @relation("CashSessionClosedBy")
  cashMovements        CashMovement[]       @relation("CashMovementActor")

  @@index([ownerId, role, active])
}

model UserBranch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  branchId  String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
}

model Device {
  id               String            @id @default(uuid()) @db.Uuid
  ownerId          String            @db.Uuid
  userId           String            @db.Uuid
  label            String
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  lastSeenAt       DateTime          @default(now())
  owner            OwnerAccount      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions         Session[]
  auditEvents      AuditEvent[]
  clientOperations ClientOperation[]
  apartados        Apartado[]
  sales            Sale[]
  cashMovements    CashMovement[]

  @@index([ownerId, userId, active])
}

model Session {
  id        String       @id @default(uuid()) @db.Uuid
  ownerId   String       @db.Uuid
  userId    String       @db.Uuid
  deviceId  String       @db.Uuid
  tokenHash String       @unique @db.VarChar(64)
  createdAt DateTime     @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  owner     OwnerAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  device    Device       @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([ownerId, revokedAt])
}

model OwnerAuthorization {
  id                String       @id @default(uuid()) @db.Uuid
  ownerId           String       @db.Uuid
  branchId          String       @db.Uuid
  authorizerUserId  String       @db.Uuid
  purpose           String
  targetOperationId String       @db.Uuid
  issuedAt          DateTime     @default(now())
  expiresAt         DateTime
  owner             OwnerAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch            Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  authorizer        User         @relation("OwnerAuthorizationAuthorizer", fields: [authorizerUserId], references: [id], onDelete: Restrict)

  @@index([ownerId, branchId, expiresAt])
  @@index([targetOperationId])
}

/// Append-only by application policy. Corrections create new events; existing rows are never rewritten by domain flows.
model AuditEvent {
  id                String       @id @default(uuid()) @db.Uuid
  ownerId           String       @db.Uuid
  branchId          String?      @db.Uuid
  actorUserId       String?      @db.Uuid
  deviceId          String?      @db.Uuid
  source            AuditSource
  action            String
  targetOperationId String?      @db.Uuid
  payload           Json?
  createdAt         DateTime     @default(now())
  owner             OwnerAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch            Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor             User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  device            Device?      @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([ownerId, branchId, createdAt])
  @@index([targetOperationId])
}

model ClientOperation {
  id               String            @id @default(uuid()) @db.Uuid
  ownerId          String            @db.Uuid
  branchId         String            @db.Uuid
  operationId      String            @db.Uuid
  actorUserId      String            @db.Uuid
  deviceId         String            @db.Uuid
  type             String
  occurredAt       DateTime
  baseCursor       BigInt?
  payload          Json
  status           OperationStatus?
  result           Json?
  latestCursor     BigInt?
  createdAt        DateTime          @default(now())
  owner            OwnerAccount      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor            User              @relation("OperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  device           Device            @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  syncChanges      SyncChange[]
  conflicts        SyncConflict[]
  stockMovements   StockMovement[]
  sales            Sale[]
  creditMovements  CreditMovement[]
  purchases        Purchase[]
  cashMovements    CashMovement[]
  apartados        Apartado[]
  loyaltyMovements LoyaltyMovement[]

  @@unique([ownerId, operationId])
  @@index([ownerId, branchId, createdAt])
}

model SyncChange {
  seq               BigInt           @id @default(autoincrement())
  ownerId           String           @db.Uuid
  branchId          String           @db.Uuid
  clientOperationId String?          @db.Uuid
  type              String
  payload           Json
  createdAt         DateTime         @default(now())
  owner             OwnerAccount     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  clientOperation   ClientOperation? @relation(fields: [clientOperationId], references: [id], onDelete: Restrict)

  @@index([ownerId, branchId, seq])
}

model SyncConflict {
  id                String             @id @default(uuid()) @db.Uuid
  ownerId           String             @db.Uuid
  branchId          String             @db.Uuid
  clientOperationId String             @db.Uuid
  kind              String
  status            SyncConflictStatus @default(OPEN)
  details           Json
  createdAt         DateTime           @default(now())
  resolvedAt        DateTime?
  owner             OwnerAccount       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  clientOperation   ClientOperation    @relation(fields: [clientOperationId], references: [id], onDelete: Restrict)

  @@index([ownerId, branchId, status, createdAt])
  @@index([clientOperationId])
}

/// Catálogo de productos por sucursal. El precio vive en centavos.
model Product {
  id            String          @id @default(uuid()) @db.Uuid
  ownerId       String          @db.Uuid
  branchId      String          @db.Uuid
  name          String          @db.VarChar(120)
  barcode       String?         @db.VarChar(64)
  priceCents    Int
  costCents     Int             @default(0)
  stockControl  Boolean         @default(true)
  unitLabel     String          @default("und") @db.VarChar(16)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  owner         OwnerAccount    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stock         ProductStock?
  movements     StockMovement[]
  purchases     PurchaseLine[]
  apartadoLines ApartadoLine[]
  rewards       LoyaltyReward[]
  promotions    Promotion[]

  @@unique([branchId, barcode])
  @@index([ownerId, branchId, active])
}

/// Proyección de stock a la mano (cantidad decimal fija como string).
model ProductStock {
  id        String       @id @default(uuid()) @db.Uuid
  ownerId   String       @db.Uuid
  branchId  String       @db.Uuid
  productId String       @unique @db.Uuid
  onHand    String       @default("0")
  /// Stock reservado por apartados/pedidos (spec §9.7): disponible = onHand − reserved.
  reserved  String       @default("0")
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  owner     OwnerAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([ownerId, branchId])
}

/// Proveedor de una sucursal. Datos maestros; el histórico de compras vive
/// en Purchase (append-only).
model Supplier {
  id         String       @id @default(uuid()) @db.Uuid
  ownerId    String       @db.Uuid
  branchId   String       @db.Uuid
  supplierId String       @unique @db.Uuid
  name       String       @db.VarChar(120)
  phoneE164  String?      @db.VarChar(16)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  owner      OwnerAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch     Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  purchases  Purchase[]

  @@index([ownerId, branchId, active])
}

/// Compra a proveedor append-only. Por línea se registra cantidad y costo
/// unitario; Product.costCents es la proyección del costo promedio móvil.
model Purchase {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @db.Uuid
  branchId          String           @db.Uuid
  purchaseId        String           @unique @db.Uuid
  supplierId        String?          @db.Uuid
  actorUserId       String           @db.Uuid
  deviceId          String           @db.Uuid
  clientOperationId String?          @db.Uuid
  note              String?          @db.VarChar(300)
  totalCents        Int
  occurredAt        DateTime
  createdAt         DateTime         @default(now())
  owner             OwnerAccount     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines             PurchaseLine[]
  clientOperation   ClientOperation? @relation(fields: [clientOperationId], references: [id], onDelete: Restrict)

  @@index([ownerId, branchId, createdAt])
}

/// Línea de compra append-only (cantidad + costo unitario en centavos).
model PurchaseLine {
  id             String       @id @default(uuid()) @db.Uuid
  ownerId        String       @db.Uuid
  branchId       String       @db.Uuid
  purchaseId     String       @db.Uuid
  productId      String       @db.Uuid
  quantity       String       @db.VarChar(32)
  unitCostCents  Int
  lineTotalCents Int
  purchase       Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  owner          OwnerAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([ownerId, branchId, productId])
}

/// Movimiento de stock append-only (nunca se borra; se corrige con reversos).
model StockMovement {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @db.Uuid
  branchId          String           @db.Uuid
  productId         String           @db.Uuid
  type              String
  quantityDelta     String           @db.VarChar(32)
  clientOperationId String?          @db.Uuid
  createdAt         DateTime         @default(now())
  owner             OwnerAccount     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product           Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  clientOperation   ClientOperation? @relation(fields: [clientOperationId], references: [id], onDelete: Restrict)

  @@index([ownerId, branchId, productId, createdAt])
  @@index([clientOperationId])
}

/// Venta append-only. Líneas/pagos/totales se persisten como JSONB inmutable.
model Sale {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @db.Uuid
  branchId          String           @db.Uuid
  saleId            String           @unique @db.Uuid
  customerId        String?          @db.Uuid
  actorUserId       String           @db.Uuid
  deviceId          String           @db.Uuid
  clientOperationId String?          @db.Uuid
  lines             Json
  payments          Json
  subtotalCents     Int
  totalCents        Int
  /// Descuento de promoción aplicado (determinístico, validado en servidor).
  discountCents     Int              @default(0)
  /// IDs de promociones aplicadas (JSON array).
  promotionIds      Json?
  /// Redención de lealtad aplicada (JSON: rewardId + pointsCost).
  reward            Json?
  /// Apartado que esta venta completa (si nació de un apartado).
  apartadoId        String?          @db.Uuid
  occurredAt        DateTime
  createdAt         DateTime         @default(now())
  owner             OwnerAccount     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor             User             @relation("SaleActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  device            Device           @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  clientOperation   ClientOperation? @relation(fields: [clientOperationId], references: [id], onDelete: Restrict)
  customer          Customer?        @relation("SaleCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  apartado          Apartado?        @relation(fields: [apartadoId], references: [id], onDelete: Restrict)

  @@index([ownerId, branchId, createdAt])
}

/// Cliente de una sucursal con límite de crédito. El saldo NUNCA se guarda
/// como campo: se computa Σ movimientos de crédito (append-only).
model Customer {
  id                 String            @id @default(uuid()) @db.Uuid
  ownerId            String            @db.Uuid
  branchId           String            @db.Uuid
  customerId         String            @unique @db.Uuid
  name               String            @db.VarChar(120)
  phoneE164          String?           @db.VarChar(16)
  creditLimitCents   Int               @default(0)
  defaultPromiseDays Int               @default(7)
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  owner              OwnerAccount      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  movements          CreditMovement[]
  sales              Sale[]            @relation("SaleCustomer")
  apartados          Apartado[]
  loyaltyMovements   LoyaltyMovement[]

  @@index([ownerId, branchId, active])
}

/// Movimiento de crédito append-only (FIAO_SALE = cargo, ABONO = descargo).
/// El saldo del cliente = Σ FIAO_SALE − Σ ABONO.
model CreditMovement {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @db.Uuid
  branchId          String           @db.Uuid
  customerId        String           @db.Uuid
  type              String
  amountCents       Int
  saleId            String?          @db.Uuid
  abonoId           String?          @db.Uuid
  clientOperationId String?          @db.Uuid
  occurredAt        DateTime
  createdAt         DateTime         @default(now())
  owner             OwnerAccount     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  clientOperation   ClientOperation? @relation(fields: [clientOperationId], references: [id], onDelete: Restrict)

  @@unique([saleId, type])
  @@index([ownerId, branchId, customerId, createdAt])
  @@index([clientOperationId])
}

/// Sesión de caja: una sola sesión abierta por sucursal (spec §10.1).
/// El esperado NUNCA se guarda: se computa desde el float inicial + ventas
/// cash no anuladas + abonos cash + movimientos (invariante 6 del roadmap).
model CashSession {
  id                String         @id @default(uuid()) @db.Uuid
  ownerId           String         @db.Uuid
  branchId          String         @db.Uuid
  sessionId         String         @unique @db.Uuid
  status            String         @default("OPEN")
  openedById        String         @db.Uuid
  openedAt          DateTime
  openingFloatCents Int
  closedById        String?        @db.Uuid
  closedAt          DateTime?
  countedCents      Int?
  differenceCents   Int?
  /// branchId cuando OPEN, null cuando CLOSED → única sesión abierta por
  /// sucursal garantizada por constraint (Postgres permite NULLs múltiples).
  openUniqueKey     String?        @unique @db.VarChar(64)
  createdAt         DateTime       @default(now())
  owner             OwnerAccount   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  openedBy          User           @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy          User?          @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  movements         CashMovement[]

  @@index([ownerId, branchId, status])
}

/// Movimiento de caja append-only: EXPENSE / WITHDRAWAL / INJECTION /
/// DIFFERENCE (el cierre registra la diferencia para cuadrar el ledger).
model CashMovement {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @db.Uuid
  branchId          String           @db.Uuid
  sessionId         String           @db.Uuid
  movementId        String           @unique @db.Uuid
  type              String
  amountCents       Int
  category          String?          @db.VarChar(60)
  description       String?          @db.VarChar(300)
  reason            String?          @db.VarChar(300)
  actorUserId       String           @db.Uuid
  deviceId          String           @db.Uuid
  clientOperationId String?          @db.Uuid
  occurredAt        DateTime
  createdAt         DateTime         @default(now())
  owner             OwnerAccount     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  session           CashSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  actor             User             @relation("CashMovementActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  device            Device           @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  clientOperation   ClientOperation? @relation(fields: [clientOperationId], references: [id], onDelete: Restrict)

  @@index([ownerId, branchId, sessionId, createdAt])
  @@index([clientOperationId])
}

/// Apartado append-only: el cliente reserva inventario con un anticipo
/// (spec §9.7). Los cambios de estado son eventos (ACTIVE → COMPLETED |
/// CANCELLED); las líneas viven en ApartadoLine.
model Apartado {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @db.Uuid
  branchId          String           @db.Uuid
  apartadoId        String           @unique @db.Uuid
  customerId        String           @db.Uuid
  status            String           @default("ACTIVE")
  depositCents      Int
  totalCents        Int
  promiseDate       DateTime?
  notes             String?          @db.VarChar(300)
  actorUserId       String           @db.Uuid
  deviceId          String           @db.Uuid
  clientOperationId String?          @db.Uuid
  completedAt       DateTime?
  cancelledAt       DateTime?
  occurredAt        DateTime
  createdAt         DateTime         @default(now())
  owner             OwnerAccount     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actor             User             @relation("ApartadoActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  device            Device           @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  clientOperation   ClientOperation? @relation(fields: [clientOperationId], references: [id], onDelete: Restrict)
  lines             ApartadoLine[]
  sales             Sale[]

  @@index([ownerId, branchId, status, createdAt])
  @@index([customerId])
}

/// Línea de apartado append-only (cantidad + precio al momento de apartar).
model ApartadoLine {
  id             String       @id @default(uuid()) @db.Uuid
  ownerId        String       @db.Uuid
  branchId       String       @db.Uuid
  apartadoId     String       @db.Uuid
  productId      String       @db.Uuid
  quantity       String       @db.VarChar(32)
  priceCents     Int
  lineTotalCents Int
  apartado       Apartado     @relation(fields: [apartadoId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  owner          OwnerAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([ownerId, branchId, productId])
}

/// Config de lealtad por owner (spec §8): regla de ganancia y vencimiento.
/// Singleton por owner (upsert).
model LoyaltyConfig {
  id                    String       @id @default(uuid()) @db.Uuid
  ownerId               String       @unique @db.Uuid
  enabled               Boolean      @default(true)
  pointsPerHundredCents Int          @default(100)
  expiryDays            Int          @default(180)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  owner                 OwnerAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}

/// Movimiento del ledger de puntos append-only (EARN/REDEEM/EXPIRE/REVERSAL).
/// El saldo NUNCA se guarda: se computa Σ deltas no vencidos.
model LoyaltyMovement {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @db.Uuid
  branchId          String           @db.Uuid
  customerId        String           @db.Uuid
  movementId        String           @unique @db.Uuid
  type              String
  pointsDelta       Int
  saleId            String?          @db.Uuid
  rewardId          String?          @db.Uuid
  reason            String?          @db.VarChar(300)
  expiresAt         DateTime?
  clientOperationId String?          @db.Uuid
  occurredAt        DateTime
  createdAt         DateTime         @default(now())
  owner             OwnerAccount     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  clientOperation   ClientOperation? @relation(fields: [clientOperationId], references: [id], onDelete: Restrict)

  @@index([ownerId, branchId, customerId, occurredAt])
  @@index([clientOperationId])
}

/// Recompensa canjeable por puntos (spec §8: free product / fixed discount).
model LoyaltyReward {
  id            String       @id @default(uuid()) @db.Uuid
  ownerId       String       @db.Uuid
  rewardId      String       @unique @db.Uuid
  name          String       @db.VarChar(80)
  kind          String
  productId     String?      @db.Uuid
  discountCents Int?
  pointsCost    Int
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  owner         OwnerAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  product       Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([ownerId, active])
}

/// Promoción determinística (spec §8 / roadmap: deterministic promotions).
/// La función pura del dominio es la única fuente de descuento.
model Promotion {
  id              String       @id @default(uuid()) @db.Uuid
  ownerId         String       @db.Uuid
  name            String       @db.VarChar(80)
  kind            String
  scope           String
  productId       String?      @db.Uuid
  percentOffCents Int?
  fixedOffCents   Int?
  buyQty          Int?
  getQty          Int?
  active          Boolean      @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime     @default(now())
  owner           OwnerAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  product         Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([ownerId, active])
}
